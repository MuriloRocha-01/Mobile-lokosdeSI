{
  "expo": {
    "name": "Lokos de S.I",
    "slug": "ecossitema-murilo-mobile",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.murilo.ecossistema"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./src/assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.murilo.ecossistema",
      "versionCode": 8,
      "permissions": [
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Escolha uma foto para seu perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "FinanceSummary",
              "label": "Lokos · Saldo e despesas",
              "description": "Saldo e últimas despesas do mês",
              "minWidth": "280dp",
              "minHeight": "300dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "FinanceAgenda",
              "label": "Lokos · Agenda financeira",
              "description": "Receitas e despesas de cada dia do mês",
              "minWidth": "280dp",
              "minHeight": "300dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "backgroundColor": "#F6F5FA",
    "scheme": "ecossistema",
    "extra": {
      "eas": {
        "projectId": "76a10a7c-19f8-4378-a424-be01e36a06a6"
      }
    },
    "owner": "dreitspok",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/76a10a7c-19f8-4378-a424-be01e36a06a6",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 5000
    }
  }
}

